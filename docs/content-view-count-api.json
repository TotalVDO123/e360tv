      "no": 3,
      "name": "Save Entertainment Views (old / backward compatible)",
      "method": "POST",
      "path": "/api/save-entertainment-views",
      "full_url": "https://e360tv.com/api/save-entertainment-views",
      "auth": "Required. Sanctum Bearer token.",
      "note": "Keep for old Android/iOS builds. New apps should use API 1. Entertainment shows are stored as film/music/tvshow based on network.",
