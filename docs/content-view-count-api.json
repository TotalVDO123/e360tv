{
  "title": "E360TV Content View Count APIs",
  "base_url": "https://e360tv.com/api",
  "storage": {
    "table": "content_views",
    "columns": ["content_type", "content_id", "user_id", "device_type", "device_id", "created_at", "updated_at"],
    "note": "One row per counted view. Counts are aggregated from this table. No schema change required for film/music — they are stored in content_type string values resolved from series_networks."
  },
  "total_apis": 3,
  "summary": [
    {
      "no": 1,
      "method": "POST",
      "url": "/api/v3/save-content-view",
      "auth": "optional",
      "note": "Call when Watch Now playback starts. Counts livetv, tvshow, episode, film, music, or video."
    },
    {
      "no": 2,
      "method": "GET",
      "url": "/api/v3/content-view-summary",
      "auth": "none",
      "note": "Display totals for a selected year (default: current year), with month-wise breakdown in by_month. by_content_type keys appear in order: livetv, tvshow, episode, film, music, video."
    },
    {
      "no": 3,
      "method": "POST",
      "url": "/api/save-entertainment-views",
      "auth": "required (Sanctum)",
      "note": "OLD API kept for old app builds. Also writes into content_views."
    }
  ],
  "common_headers": {
    "required": {
      "Content-Type": "application/json",
      "Accept": "application/json",
      "device-type": "website | android | ios | android_tv | roku_tv | amazon_fire_tv"
    },
    "optional": {
      "Authorization": "Bearer {sanctum_token}"
    },
    "device_type_values": {
      "website": "Website",
      "android": "Android",
      "ios": "iOS",
      "android_tv": "Android TV",
      "roku_tv": "Roku TV",
      "amazon_fire_tv": "Amazon Fire TV"
    },
    "device_type_aliases": {
      "web": "website",
      "iphone": "ios",
      "ipad": "ios",
      "tv": "android_tv",
      "roku": "roku_tv",
      "fire_tv": "amazon_fire_tv",
      "firetv": "amazon_fire_tv"
    }
  },
  "content_type_values": {
    "allowed": ["livetv", "tvshow", "episode", "film", "music", "video"],
    "display_order": ["livetv", "tvshow", "episode", "film", "music", "video"],
    "aliases_accepted": {
      "movie": "Mapped then resolved like film/tvshow from networks (legacy)",
      "vedio": "video"
    },
    "rules": {
      "livetv": "Send live_tv_channel.id. Use when URL is livetv-details/{slug}.",
      "tvshow": "Send entertainments.id for a normal TV show (not e360films / e360music). Server also re-resolves film/music from series_networks if client sends tvshow.",
      "episode": "Send episodes.id when user watches a specific episode",
      "film": "Send entertainments.id when show belongs to network e360films or e360film (example: /tvshow-details/sami-blood).",
      "music": "Send entertainments.id when show belongs to network e360music (example: /tvshow-details/country-music).",
      "video": "Send videos.id"
    }
  },
  "apis": [
    {
      "no": 1,
      "name": "Save Content View",
      "method": "POST",
      "path": "/api/v3/save-content-view",
      "full_url": "https://e360tv.com/api/v3/save-content-view",
      "auth": "Optional. Never returns 401 for missing login.",
      "when_to_call": "When user clicks Watch Now and playback actually starts.",
      "headers": {
        "Content-Type": "application/json",
        "Accept": "application/json",
        "device-type": "android",
        "Authorization": "Bearer {token}   // optional, only if logged in"
      },
      "request_body": {
        "content_type": "tvshow",
        "content_id": 220,
        "user_id": 10,
        "device_id": "a1b2c3d4-device-uuid",
        "device_type": "android"
      },
      "request_body_fields": {
        "content_type": {
          "type": "string",
          "required": true,
          "values": ["livetv", "tvshow", "episode", "film", "music", "video"],
          "aliases": ["movie", "vedio"]
        },
        "content_id": {
          "type": "integer",
          "required": true,
          "description": "tvshow/film/music = entertainments.id, episode = episodes.id, video = videos.id, livetv = live_tv_channel.id"
        },
        "user_id": {
          "type": "integer",
          "required": false,
          "description": "Send when user is logged in. Server also reads auth token."
        },
        "device_id": {
          "type": "string",
          "required": false,
          "description": "App install id. Recommended for guests."
        },
        "device_type": {
          "type": "string",
          "required": false,
          "values": ["website", "android", "ios", "android_tv", "roku_tv", "amazon_fire_tv"],
          "description": "Optional if header device-type is sent."
        }
      },
      "request_body_examples": {
        "livetv_roku": {
          "content_type": "livetv",
          "content_id": 15,
          "device_type": "roku_tv"
        },
        "tvshow_from_network_roku": {
          "content_type": "tvshow",
          "content_id": 220,
          "device_type": "roku_tv"
        },
        "episode_ios": {
          "content_type": "episode",
          "content_id": 4581,
          "user_id": 10,
          "device_id": "iphone-uuid-1",
          "device_type": "ios"
        },
        "film_e360films_android": {
          "content_type": "film",
          "content_id": 330,
          "user_id": 10,
          "device_id": "pixel-uuid-1",
          "device_type": "android",
          "note": "Example: sami-blood on e360Films network"
        },
        "music_e360music_website": {
          "content_type": "music",
          "content_id": 160,
          "device_type": "website",
          "note": "Example: country-music on e360music network"
        },
        "video_android": {
          "content_type": "video",
          "content_id": 55,
          "device_type": "android"
        },
        "tvshow_android_tv": {
          "content_type": "tvshow",
          "content_id": 220,
          "device_type": "android_tv"
        },
        "guest_website_film": {
          "content_type": "film",
          "content_id": 330,
          "device_type": "website"
        }
      },
      "success_response": {
        "http_status": 200,
        "body": {
          "status": true,
          "message": "View saved",
          "data": {
            "content_type": "tvshow",
            "content_id": 220,
            "user_id": 10,
            "device_type": "android",
            "device_id": "pixel-uuid-1",
            "counted": true,
            "throttled": false,
            "is_unique_user": true,
            "view_count": {
              "total_views": 15420,
              "unique_users": 8310,
              "by_device": {
                "website": { "total_views": 4200, "unique_users": 2100 },
                "android": { "total_views": 7100, "unique_users": 3900 },
                "ios": { "total_views": 2800, "unique_users": 1600 },
                "android_tv": { "total_views": 1320, "unique_users": 710 },
                "roku_tv": { "total_views": 0, "unique_users": 0 },
                "amazon_fire_tv": { "total_views": 0, "unique_users": 0 }
              }
            }
          }
        }
      },
      "throttled_response": {
        "http_status": 200,
        "note": "Same user/guest already counted this content on this device within 30 minutes.",
        "body": {
          "status": true,
          "message": "View already counted",
          "data": {
            "content_type": "tvshow",
            "content_id": 220,
            "counted": false,
            "throttled": true,
            "is_unique_user": false
          }
        }
      },
      "error_response_invalid_content": {
        "http_status": 422,
        "body": {
          "status": false,
          "message": "Invalid content_type or content_id"
        }
      },
      "error_response_invalid_device": {
        "http_status": 422,
        "body": {
          "status": false,
          "message": "device-type must be one of: website, android, ios, android_tv, roku_tv, amazon_fire_tv"
        }
      }
    },
