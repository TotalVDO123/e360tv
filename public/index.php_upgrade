<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>e360tv | Upgrading Your Viewing Experience</title>

  <style>
    :root {
      --bg: #070711;
      --bg2: #111326;
      --panel: rgba(255, 255, 255, 0.075);
      --panel-border: rgba(255, 255, 255, 0.16);
      --text: #f7f7fb;
      --muted: #b9bbca;
      --red: #e73535;
      --red-dark: #8c1717;
      --blue: #26a8ff;
      --purple: #7b3cff;
      --gold: #ffcb58;
      --green: #35e08a;
      --shadow: 0 24px 70px rgba(0, 0, 0, 0.45);
    }

    * {
      box-sizing: border-box;
    }

    html,
    body {
      margin: 0;
      min-height: 100%;
      font-family: Arial, Helvetica, sans-serif;
      color: var(--text);
      background: var(--bg);
    }

    body {
      overflow-x: hidden;
    }

    .page {
      position: relative;
      min-height: 100vh;
      display: flex;
      align-items: flex-start;
      justify-content: center;
      padding: 10px 18px 22px;
      isolation: isolate;
    }

    .page::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -3;
      background:
        radial-gradient(circle at 12% 18%, rgba(231, 53, 53, 0.38), transparent 28%),
        radial-gradient(circle at 86% 20%, rgba(38, 168, 255, 0.34), transparent 30%),
        radial-gradient(circle at 70% 86%, rgba(123, 60, 255, 0.3), transparent 31%),
        linear-gradient(135deg, #06060f 0%, #111326 48%, #080810 100%);
    }

    .page::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -2;
      opacity: 0.22;
      background-image:
        linear-gradient(rgba(255,255,255,0.08) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.08) 1px, transparent 1px);
      background-size: 44px 44px;
      mask-image: radial-gradient(circle at center, black, transparent 78%);
    }

    .glow-ring {
      position: fixed;
      width: 620px;
      height: 620px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.08);
      z-index: -1;
      animation: slowSpin 28s linear infinite;
      top: -80px;
    }

    .glow-ring::before,
    .glow-ring::after {
      content: "";
      position: absolute;
      inset: 48px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.08);
    }

    .glow-ring::after {
      inset: 118px;
      border-color: rgba(255,255,255,0.13);
    }

    @keyframes slowSpin {
      to {
        transform: rotate(360deg);
      }
    }

    .card {
      width: min(1060px, 100%);
      display: grid;
      grid-template-columns: 1.05fr 0.95fr;
      gap: 0;
      background: linear-gradient(145deg, rgba(255,255,255,0.11), rgba(255,255,255,0.045));
      border: 1px solid var(--panel-border);
      border-radius: 30px;
      overflow: hidden;
      box-shadow: var(--shadow);
      backdrop-filter: blur(22px);
    }

    .content {
      padding: 26px 38px 34px 28px;
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }

    .brand {
      display: inline-flex;
      align-items: center;
      margin-bottom: 28px;
    }

    .brand-logo {
      display: block;
      width: min(245px, 70vw);
      height: auto;
      filter: drop-shadow(0 10px 28px rgba(0, 0, 0, 0.42));
    }

    .eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      padding: 13px 20px;
      border-radius: 999px;
      margin-bottom: 18px;
      background: rgba(255,255,255,0.1);
      border: 1px solid rgba(255,255,255,0.18);
      color: #ffffff;
      font-size: 17px;
      font-weight: 600;
      letter-spacing: 0.1px;
      box-shadow:
        0 10px 28px rgba(0, 0, 0, 0.22),
        inset 0 1px 0 rgba(255, 255, 255, 0.12);
    }

    .live-dot {
      width: 11px;
      height: 11px;
      border-radius: 50%;
      background: var(--green);
      box-shadow: 0 0 0 0 rgba(53, 224, 138, 0.75);
      animation: pulse 1.8s infinite;
      flex: 0 0 auto;
    }

    @keyframes pulse {
      70% {
        box-shadow: 0 0 0 12px rgba(53, 224, 138, 0);
      }

      100% {
        box-shadow: 0 0 0 0 rgba(53, 224, 138, 0);
      }
    }

    h1 {
      margin: 0;
      max-width: 720px;
      font-size: clamp(38px, 6.3vw, 68px);
      line-height: 0.95;
      letter-spacing: -2.6px;
    }

    h1 span {
      color: transparent;
      background: linear-gradient(90deg, #fff, #ffcb58 38%, #26a8ff);
      -webkit-background-clip: text;
      background-clip: text;
    }

    .message {
      max-width: 610px;
      margin: 20px 0 0;
      color: var(--muted);
      font-size: clamp(16px, 1.8vw, 19px);
      line-height: 1.46;
    }

    .message strong {
      color: #fff;
      font-weight: 700;
    }

    .tagline {
      display: flex;
      flex-wrap: wrap;
      gap: 9px;
      margin-top: 24px;
    }

    .tagline span {
      padding: 8px 12px;
      border-radius: 999px;
      background: rgba(255,255,255,0.07);
      border: 1px solid rgba(255,255,255,0.12);
      color: #f1f1f5;
      font-size: 13px;
    }

    .status {
      margin-top: 26px;
      width: min(520px, 100%);
    }

    .status-top {
      display: flex;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 9px;
      color: var(--muted);
      font-size: 13px;
    }

    .bar {
      height: 10px;
      border-radius: 999px;
      background: rgba(255,255,255,0.1);
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.08);
    }

    .bar-fill {
      height: 100%;
      width: 72%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--red), var(--gold), var(--blue));
      animation: working 3.5s ease-in-out infinite;
      transform-origin: left;
    }

    @keyframes working {
      0%, 100% {
        transform: scaleX(0.68);
      }

      50% {
        transform: scaleX(1);
      }
    }

    .footer-note {
      margin-top: 18px;
      color: rgba(255,255,255,0.52);
      font-size: 13px;
    }

    .side {
      position: relative;
      min-height: 565px;
      padding: 26px;
      background:
        linear-gradient(180deg, rgba(0,0,0,0.05), rgba(0,0,0,0.4)),
        radial-gradient(circle at 50% 26%, rgba(255,255,255,0.16), transparent 22%);
      overflow: hidden;
    }

    .screen-stack {
      position: absolute;
      inset: 0;
      display: grid;
      place-items: center;
      padding: 28px;
      transform: translateY(-18px);
    }

    .tv {
      position: relative;
      width: min(390px, 100%);
      aspect-ratio: 16 / 10;
      border-radius: 26px;
      background: #0d0f1f;
      border: 1px solid rgba(255,255,255,0.18);
      box-shadow:
        0 34px 80px rgba(0,0,0,0.52),
        inset 0 0 0 1px rgba(255,255,255,0.06);
      overflow: hidden;
      transform: rotate(-2deg);
    }

    .tv::before {
      content: "";
      position: absolute;
      inset: 0;
      background:
        linear-gradient(120deg, transparent, rgba(255,255,255,0.11), transparent),
        radial-gradient(circle at 18% 20%, rgba(231,53,53,0.75), transparent 28%),
        radial-gradient(circle at 86% 24%, rgba(38,168,255,0.72), transparent 28%),
        radial-gradient(circle at 48% 88%, rgba(123,60,255,0.58), transparent 36%),
        linear-gradient(145deg, #15172c, #05050c);
    }

    .tv::after {
      content: "";
      position: absolute;
      inset: 18px;
      border-radius: 18px;
      border: 1px solid rgba(255,255,255,0.14);
    }

    .play {
      position: absolute;
      left: 50%;
      top: 50%;
      width: 78px;
      height: 78px;
      transform: translate(-50%, -50%);
      border-radius: 50%;
      display: grid;
      place-items: center;
      background: rgba(255,255,255,0.16);
      border: 1px solid rgba(255,255,255,0.28);
      backdrop-filter: blur(8px);
    }

    .play i {
      width: 0;
      height: 0;
      margin-left: 7px;
      border-top: 15px solid transparent;
      border-bottom: 15px solid transparent;
      border-left: 24px solid white;
    }

    .lower-card {
      position: absolute;
      left: 26px;
      right: 26px;
      bottom: 26px;
      padding: 18px;
      border-radius: 22px;
      background: rgba(7, 7, 17, 0.58);
      border: 1px solid rgba(255,255,255,0.16);
      backdrop-filter: blur(18px);
    }

    .lower-card p {
      margin: 0;
      color: var(--muted);
      font-size: 14px;
      line-height: 1.45;
    }

    .lower-card strong {
      display: block;
      margin-bottom: 6px;
      color: #fff;
      font-size: 16px;
    }

    .orbit {
      position: absolute;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.15);
      animation: drift 8s ease-in-out infinite;
    }

    .orbit.one {
      width: 100px;
      height: 100px;
      top: 48px;
      right: 28px;
    }

    .orbit.two {
      width: 68px;
      height: 68px;
      left: 34px;
      top: 130px;
      animation-delay: -2s;
    }

    @keyframes drift {
      0%, 100% {
        transform: translateY(0);
      }

      50% {
        transform: translateY(18px);
      }
    }

    a {
      color: inherit;
    }

    @media (max-width: 860px) {
      .page {
        padding-top: 8px;
      }

      .card {
        grid-template-columns: 1fr;
      }

      .content {
        padding: 24px 26px 28px;
      }

      .side {
        min-height: 340px;
      }

      .screen-stack {
        transform: translateY(-28px);
      }

      h1 {
        letter-spacing: -2px;
      }

      .lower-card {
        bottom: 18px;
      }
    }

    @media (max-width: 520px) {
      .page {
        padding: 8px;
        align-items: flex-start;
      }

      .card {
        border-radius: 20px;
      }

      .content {
        padding: 18px 16px 22px;
      }

      .brand {
        margin-bottom: 18px;
      }

      .brand-logo {
        width: min(200px, 76vw);
      }

      .eyebrow {
        font-size: 14px;
        padding: 10px 14px;
        margin-bottom: 14px;
      }

      .live-dot {
        width: 9px;
        height: 9px;
      }

      h1 {
        font-size: 38px;
        letter-spacing: -1.5px;
      }

      .message {
        margin-top: 16px;
        font-size: 16px;
        line-height: 1.42;
      }

      .tagline {
        margin-top: 20px;
      }

      .status {
        margin-top: 22px;
      }

      .footer-note {
        margin-top: 14px;
      }

      .side {
        min-height: 300px;
        padding: 18px;
      }

      .tv {
        width: min(330px, 94%);
      }

      .lower-card {
        left: 16px;
        right: 16px;
        bottom: 16px;
        padding: 15px;
      }

      .lower-card p {
        font-size: 13px;
      }
    }

    @media (max-height: 760px) and (min-width: 861px) {
      .page {
        padding-top: 8px;
      }

      .content {
        padding: 24px 34px 28px 26px;
      }

      .brand {
        margin-bottom: 18px;
      }

      .brand-logo {
        width: 220px;
      }

      .eyebrow {
        font-size: 16px;
        padding: 11px 18px;
        margin-bottom: 16px;
      }

      h1 {
        font-size: 58px;
      }

      .message {
        margin-top: 16px;
        font-size: 17px;
        line-height: 1.4;
      }

      .tagline {
        margin-top: 20px;
      }

      .status {
        margin-top: 22px;
      }

      .footer-note {
        margin-top: 14px;
      }

      .side {
        min-height: 520px;
      }

      .tv {
        width: min(360px, 100%);
      }
    }
  </style>
</head>

<body>
  <main class="page">
    <div class="glow-ring" aria-hidden="true"></div>

    <section class="card" aria-label="e360tv maintenance notice">
      <div class="content">
        <div class="brand">
          <img
            class="brand-logo"
            src="https://e360tv.com/Maintenenacelogo.png"
            alt="e360tv"
          />
        </div>

        <div class="eyebrow">
          <span class="live-dot"></span>
          Platform upgrade in progress
        </div>

        <h1>
          We’re upgrading your <span>viewing experience.</span>
        </h1>

        <p class="message">
          e360tv is getting a refresh behind the scenes so we can bring you a faster,
          cleaner, and better streaming experience. We’ll be back shortly with the
          shows, stories, and independent voices you came here to watch.
        </p>

        <div class="tagline" aria-label="Platform features">
          <span>Live Shows</span>
          <span>On-Demand Video</span>
          <span>Independent Creators</span>
          <span>Streaming Everywhere</span>
        </div>

        <div class="status">
          <div class="status-top">
            <span>System refresh</span>
            <span id="statusText">Optimizing platform</span>
          </div>

          <div class="bar" aria-hidden="true">
            <div class="bar-fill"></div>
          </div>
        </div>

        <div class="footer-note">
          © <span id="year"></span> e360tv. Thank you for your patience.
        </div>
      </div>

      <aside class="side" aria-hidden="true">
        <div class="orbit one"></div>
        <div class="orbit two"></div>

        <div class="screen-stack">
          <div class="tv">
            <div class="play">
              <i></i>
            </div>
          </div>
        </div>

        <div class="lower-card">
          <strong>Broadcast pause. Better signal ahead.</strong>
          <p>
            Our team is tuning the experience so viewers and creators can connect
            more smoothly across web, mobile, and TV platforms.
          </p>
        </div>
      </aside>
    </section>
  </main>

  <script>
    const year = document.getElementById("year");
    const statusText = document.getElementById("statusText");

    year.textContent = new Date().getFullYear();

    const messages = [
      "Optimizing platform",
      "Refreshing show pages",
      "Improving playback flow",
      "Preparing the next experience"
    ];

    let index = 0;

    setInterval(() => {
      index = (index + 1) % messages.length;
      statusText.textContent = messages[index];
    }, 2600);
  </script>
</body>
</html>